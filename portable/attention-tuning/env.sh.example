# 复制为 env.sh 后按目标机器修改；标准安装路径可自动发现，无需全部设置。
# PYTHON 运行标准库脚本，GPU_PYTHON 运行 launchKernel.py 和 GPU 环境检查。
# export PYTHON=/path/to/python3
# export GPU_PYTHON=/path/to/hip-pytorch-env/bin/python
export LLVM_DIR=/workspace/deepgengraph/dtk/aillvm/bin
export ROCM_BC=/opt/dtk/amdgcn/bitcode
export LD_LIBRARY_PATH=/opt/dtk/lib:${LD_LIBRARY_PATH:-}
#
# 当前 MyTest 的硬件配置面向 DCU，默认目标 gfx936。
# 修改 GPU_ARCH 并不能让当前 MyTest 自动适配任意其他 GPU 架构。
# export GPU_ARCH=gfx936
# export GPU_FEATURES=
# export DWARF_VERSION=4
#
# 如随包二进制不兼容目标系统，在目标机用同版源码构建 MyTest，
# 替换包根目录的 MyTest，或指定路径：
# export MYTEST=/path/to/deepgengraph/build/test/MyTest
#
# 可选：开启单独 LLVM IR 验证。应使用兼容导出 IR 的 llvm-as 版本。
# export LLVM_AS=/path/to/llvm-as
